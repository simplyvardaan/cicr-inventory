{
  "name": "cicr-inventory-backend",
  "version": "2.14.5",
  "description": "Express + TypeScript backend for CICR Robotics Inventory Hub",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node --project tsconfig.json src/server.ts",
    "build": "tsc && node scripts/ensure-render-dist.cjs",
    "postinstall": "tsc && node scripts/ensure-render-dist.cjs",
    "start": "node dist/server.js",
    "seed:inventory": "ts-node --project tsconfig.json src/scripts/seed-inventory.ts",
    "purge-logs": "node src/scripts/purge-all-logs.cjs",
    "test": "node --test --test-concurrency=1 \"test/*.test.cjs\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.1.0",
    "compression": "^1.8.2",
    "connect-redis": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "typescript": "^5.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2"
  }
}
