{
  "name": "cicr-inventory",
  "private": true,
  "version": "2.13.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"frontend,backend\" -c \"cyan,magenta\" \"vite\" \"npm start --prefix backend\"",
    "dev:frontend": "vite",
    "dev:backend": "npm start --prefix backend",
    "backend": "npm start --prefix backend",
    "build": "tsc && vite build",
    "build:backend": "npm run build --prefix backend",
    "start": "npm start --prefix backend",
    "purge-logs": "npm run purge-logs --prefix backend",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "lucide": "^1.29.0",
    "three": "^0.186.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
